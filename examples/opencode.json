{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "m365": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Microsoft 365 Copilot",
      "options": {
        "baseURL": "http://127.0.0.1:8765/v1",
        "apiKey": "unused",
        "timeout": 600000,
        "chunkTimeout": 300000
      },
      "models": {
        "claude-sonnet": {
          "name": "M365 Claude Sonnet",
          "limit": { "context": 128000, "output": 16384 }
        },
        "claude-sonnet-work": {
          "name": "M365 Claude Sonnet (Work IQ)",
          "limit": { "context": 128000, "output": 16384 }
        },
        "claude-opus": {
          "name": "M365 Claude Opus",
          "limit": { "context": 128000, "output": 16384 }
        },
        "claude-opus-work": {
          "name": "M365 Claude Opus (Work IQ)",
          "limit": { "context": 128000, "output": 16384 }
        },
        "gpt-5.6-reasoning": {
          "name": "M365 GPT 5.6 Reasoning",
          "limit": { "context": 128000, "output": 16384 }
        },
        "gpt-5.6-reasoning-work": {
          "name": "M365 GPT 5.6 Reasoning (Work IQ)",
          "limit": { "context": 128000, "output": 16384 }
        },
        "gpt-5.6-chat": {
          "name": "M365 GPT 5.6 Chat",
          "limit": { "context": 128000, "output": 16384 }
        },
        "gpt-5.6-chat-work": {
          "name": "M365 GPT 5.6 Chat (Work IQ)",
          "limit": { "context": 128000, "output": 16384 }
        },
        "gpt-5.5-chat": {
          "name": "M365 GPT 5.5 Chat",
          "limit": { "context": 128000, "output": 16384 }
        },
        "gpt-5.5-chat-work": {
          "name": "M365 GPT 5.5 Chat (Work IQ)",
          "limit": { "context": 128000, "output": 16384 }
        },
        "magic": {
          "name": "M365 Auto",
          "limit": { "context": 128000, "output": 16384 }
        },
        "magic-work": {
          "name": "M365 Auto (Work IQ)",
          "limit": { "context": 128000, "output": 16384 }
        },
        "chat": {
          "name": "M365 Quick",
          "limit": { "context": 128000, "output": 16384 }
        },
        "chat-work": {
          "name": "M365 Quick (Work IQ)",
          "limit": { "context": 128000, "output": 16384 }
        },
        "reasoning": {
          "name": "M365 Think Deeper",
          "limit": { "context": 128000, "output": 16384 }
        },
        "reasoning-work": {
          "name": "M365 Think Deeper (Work IQ)",
          "limit": { "context": 128000, "output": 16384 }
        }
      }
    }
  },
  "model": "m365/claude-sonnet",
  "small_model": "m365/chat"
}
